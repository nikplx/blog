---
import { kUrlBase } from "$consts";

const today = new Date();
---

<footer>
  <div class="footer-inner">
    <span class="copyright">
      &copy; {today.getFullYear()} Niklas Paulicks
    </span>
    <nav class="footer-links" aria-label="Footer">
      <a href="https://github.com/nikplx" target="_blank" rel="noopener">
        <span class="icon" aria-hidden="true">
          <svg viewBox="0 0 16 16"
            ><path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
        </span>
        GitHub
      </a>
      <a href={`${kUrlBase}/rss.xml`} target="_blank" rel="noopener">
        <span class="icon" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"
            ><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.-->
            <path
              d="M0 64C0 46.3 14.3 32 32 32c229.8 0 416 186.2 416 416c0 17.7-14.3 32-32 32s-32-14.3-32-32C384 253.6 226.4 96 32 96C14.3 96 0 81.7 0 64zM0 416a64 64 0 1 1 128 0A64 64 0 1 1 0 416zM32 160c159.1 0 288 128.9 288 288c0 17.7-14.3 32-32 32s-32-14.3-32-32c0-123.7-100.3-224-224-224c-17.7 0-32-14.3-32-32s14.3-32 32-32z"
            ></path></svg
          >
        </span>
        RSS
      </a>
      <a href={`${kUrlBase}/acknowledgements/`}>Acknowledgements</a>
      <a href={`${kUrlBase}/impressum/`}>Impressum</a>
      <a href={`${kUrlBase}/privacy/`}>Privacy Policy</a>
    </nav>
  </div>
</footer>

<style>
  footer {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 50;
    padding: 0.5em 1em;
    background: var(--nav-bg-color);
    border-top: 1px solid var(--raw-bg-color);
    box-shadow: 0 -2px 8px rgba(var(--black), 5%);
    color: var(--main-color);
    font-size: 0.85em;
    line-height: 1.5;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.15em 1.25em;
    max-width: min(56rem, calc(100% - 2em));
    margin: auto;
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0.15em 1em;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    color: var(--main-color);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--main-hover-color);
    text-decoration: underline;
  }
  .footer-links .icon svg {
    width: 1em;
    height: 1em;
  }
</style>
